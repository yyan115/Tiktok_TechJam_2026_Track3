{
  "permissions": {
    "deny": [
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(.git/**)",
      "Write(.git/**)",
      "Edit(**/.git/**)",
      "Write(**/.git/**)",
      "Edit(**/.gitignore)",
      "Write(**/.gitignore)",
      "Edit(**/.gitattributes)",
      "Write(**/.gitattributes)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(README.md)",
      "Write(README.md)",
      "Edit(torch_transformer_benchmark.py)",
      "Write(torch_transformer_benchmark.py)",
      "Edit(tensorflow_transformer_benchmark.py)",
      "Write(tensorflow_transformer_benchmark.py)",
      "Edit(Project/PLAN.md)",
      "Write(Project/PLAN.md)",
      "Edit(Project/RUNBOOK.md)",
      "Write(Project/RUNBOOK.md)",
      "Edit(Project/GRIND_ENTRYPOINT.md)",
      "Write(Project/GRIND_ENTRYPOINT.md)",
      "Edit(Project/manifest.json)",
      "Write(Project/manifest.json)",
      "Edit(Project/shapes.json)",
      "Write(Project/shapes.json)",
      "Edit(Project/device_peaks.json)",
      "Write(Project/device_peaks.json)",
      "Edit(Project/harness/**)",
      "Write(Project/harness/**)",
      "Edit(Project/tools/**)",
      "Write(Project/tools/**)",
      "Edit(Project/authority/**)",
      "Write(Project/authority/**)",
      "Edit(Project/audits/**)",
      "Write(Project/audits/**)",
      "Edit(Project/results/**)",
      "Write(Project/results/**)",
      "Edit(Project/results_side/**)",
      "Write(Project/results_side/**)",
      "Edit(Project/lock_staging/**)",
      "Write(Project/lock_staging/**)",
      "Edit(Project/loop/gate_state.json)",
      "Write(Project/loop/gate_state.json)",
      "Edit(Project/loop/gate_log.jsonl)",
      "Write(Project/loop/gate_log.jsonl)",
      "Edit(Project/loop/mechanism_catalog.json)",
      "Write(Project/loop/mechanism_catalog.json)",
      "Edit(Project/loop/mechanism_catalog.schema.json)",
      "Write(Project/loop/mechanism_catalog.schema.json)",
      "Edit(Project/loop/permits_used/**)",
      "Write(Project/loop/permits_used/**)",
      "Edit(Project/loop/requests/**)",
      "Write(Project/loop/requests/**)",
      "Edit(Project/loop/profile_evidence/**)",
      "Write(Project/loop/profile_evidence/**)",
      "Edit(Project/submission/torch_transformer_benchmark_submission.py)",
      "Write(Project/submission/torch_transformer_benchmark_submission.py)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(ln:*)",
      "Bash(dd:*)",
      "Bash(tee:*)",
      "Bash(truncate:*)",
      "Bash(shred:*)",
      "Bash(install:*)",
      "Bash(rsync:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(find:*)",
      "Bash(xargs:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(modprobe:*)",
      "Bash(systemctl:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git rebase:*)",
      "Bash(git filter-branch:*)",
      "Bash(git push:*)",
      "Bash(git config:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\"",
            "timeout": 10,
            "statusMessage": "Enforcing owner LOCK allowlist"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '=== PROJECT STATE (auto-injected by SessionStart hook; read Project/GRIND_ENTRYPOINT.md for the canonical brief) ==='; cat \"$CLAUDE_PROJECT_DIR/Project/memory/STATE.md\" 2>/dev/null || echo 'STATE.md not found'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/Project/tools/session_bootstrap.py\"",
            "timeout": 30,
            "statusMessage": "Verifying LOCK and loading canonical GRIND state"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/Project/tools/champion_watch.py\" || true",
            "async": true,
            "timeout": 30,
            "statusMessage": "Reconciling authority and independent audits"
          }
        ]
      }
    ]
  }
}
