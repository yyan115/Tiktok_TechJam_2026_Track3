{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.techjam.invalid/audit/verdict-v2.schema.json",
  "title": "Bound benchmark integrity and technical-review verdict",
  "type": "object",
  "required": [
    "schema_version",
    "attempt_nonce",
    "entry_id",
    "packet_sha256",
    "candidate_sha256",
    "integrity",
    "technical_review",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "attempt_nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry_id": {
      "type": "string",
      "pattern": "^(?:[0-9]{8}-[0-9]{6}(?:-[0-9a-f]{6})?|run-[0-9a-f]{32})$"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "integrity": { "$ref": "#/$defs/integrityVerdict" },
    "technical_review": { "$ref": "#/$defs/technicalVerdict" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 }
  },
  "additionalProperties": false,
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["severity", "file", "issue", "suggested_fix"],
      "properties": {
        "severity": {
          "type": "string",
          "enum": ["blocker", "major", "minor", "note"]
        },
        "file": { "type": "string", "maxLength": 1000 },
        "issue": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "suggested_fix": { "type": "string", "maxLength": 4000 }
      },
      "additionalProperties": false
    },
    "integrityVerdict": {
      "type": "object",
      "required": ["verdict", "findings", "retest_request", "summary"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["PASS", "RETEST", "NEEDS_CONTEXT", "RULE_VIOLATION"]
        },
        "findings": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/finding" }
        },
        "retest_request": { "type": "string", "maxLength": 4000 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "verdict": { "const": "RETEST" } },
            "required": ["verdict"]
          },
          "then": {
            "properties": { "retest_request": { "minLength": 1 } }
          },
          "else": {
            "properties": { "retest_request": { "maxLength": 0 } }
          }
        }
      ],
      "additionalProperties": false
    },
    "technicalVerdict": {
      "type": "object",
      "required": ["verdict", "findings", "summary"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "PASS",
            "WEAK_DIAGNOSIS",
            "TECHNICAL_DISAGREEMENT",
            "MISSING_EVIDENCE"
          ]
        },
        "findings": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/finding" }
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 }
      },
      "additionalProperties": false
    }
  }
}
